generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  engineType      = "client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Assignment {
  id         Int       @id @default(autoincrement())
  course     String
  title      String
  note       String?
  dueAt      DateTime
  done       Boolean   @default(false)
  doneAt     DateTime?
  externalId String?   @unique
  canvasUrl  String?
  createdAt  DateTime  @default(now())
}

model Exam {
  id         Int      @id @default(autoincrement())
  course     String
  title      String
  dueAt      DateTime
  externalId String?  @unique
  canvasUrl  String?
  createdAt  DateTime @default(now())
}

model ClassBlock {
  id       Int     @id @default(autoincrement())
  course   String
  room     String?
  weekday  Int
  startMin Int
  endMin   Int
}

model Transaction {
  id        Int      @id @default(autoincrement())
  label     String
  amount    Float
  createdAt DateTime @default(now())
}

model Settings {
  id                  Int     @id @default(1)
  balance             Float   @default(3500)
  canvasUrl           String?
  spotifyRefreshToken String?
  googleRefreshToken  String?
}

model NotifyLog {
  id     Int      @id @default(autoincrement())
  key    String   @unique
  sentAt DateTime @default(now())
}

model CompanionDigest {
  id        Int      @id @default(1)
  text      String
  topic     String   @default("schedule")
  createdAt DateTime @default(now())
}

// Singleton tracking which workout day (A/B) is active and, once every
// exercise in it is checked off, a cooldownUntil timestamp — the app
// auto-alternates to the other day once that passes (see api/workout).
model WorkoutState {
  id            Int       @id @default(1)
  activeDay     String    @default("A")
  cooldownUntil DateTime?
}

// A row's existence means that exercise is checked off for the current
// session of that day — nothing marks "unchecked", unchecking just
// deletes the row. Rows are cleared when a day's cooldown expires and it
// becomes active again, giving it a fresh start.
model WorkoutSessionCheck {
  id        Int      @id @default(autoincrement())
  day       String
  exercise  String
  createdAt DateTime @default(now())

  @@unique([day, exercise])
}
