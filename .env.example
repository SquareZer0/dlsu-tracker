# Local dev: plain SQLite file, no setup needed
DATABASE_URL="file:./dev.db"

# Production only (Vercel): a free Turso database, see README
# TURSO_DATABASE_URL="libsql://<your-db>.turso.io"
# TURSO_AUTH_TOKEN="<your-token>"

# Shared passcode for the app's login screen
PASSCODE="changeme"
# Random string used to sign the auth cookie — any long random value
AUTH_SECRET="changeme-too"

# ntfy.sh topic — pick something unguessable, e.g. miguel-dlsu-tracker-x7k2p
NTFY_TOPIC="miguel-dlsu-tracker-x7k2p"

# Your Canvas calendar feed (.ics) URL
CANVAS_ICS_URL="https://dlsu.instructure.com/feeds/calendars/REPLACE_ME.ics"

# Secret the GitHub Actions cron job must send to hit /api/cron/notify
CRON_SECRET="changeme-cron"
